# Kilter app account email and password
KILTER_USERNAME=you@example.com
KILTER_PASSWORD=your-kilter-password

# Tension Board account username and password
TENSION_USERNAME=your-tension-username
TENSION_PASSWORD=your-tension-password

# Google spreadsheet ID (from its URL)
SHEET_ID=your-google-sheet-id

# For local use, set this to a service-account JSON file path.
GOOGLE_APPLICATION_CREDENTIALS=credentials.json
